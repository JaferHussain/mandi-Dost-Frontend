{
  "expo": {
    "name": "منڈی دوست",
    "slug": "mandi-dost",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mandidost",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "pk.mandidost.app",
      "supportsTablet": false
    },
    "android": {
      "package": "pk.mandidost.app",
      "adaptiveIcon": {
        "backgroundColor": "#166534",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#166534",
          "image": "./assets/images/icon.png",
          "imageWidth": 160
        }
      ],
      "expo-audio",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
